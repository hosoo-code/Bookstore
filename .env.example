# Copy to .env and fill in. Never commit .env.

# Required: PostgreSQL connection string (local Termux Postgres or Supabase session pooler)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: public site URL (used for sitemap / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: show tögrög (₮) instead of dollars
NEXT_PUBLIC_CURRENCY=MNT

# Optional: Supabase (Auth, Realtime). Leave empty for local accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Cloudflare R2 for image uploads (leave empty to save in public/uploads locally)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL (r2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_URL=

# Optional: Bonum payment gateway (QPay). Requires NEXT_PUBLIC_CURRENCY=MNT and a public https NEXT_PUBLIC_SITE_URL.
# Test: https://testapi.bonum.mn  Production: https://apis.bonum.mn
BONUM_GATEWAY_BASE_URL=
BONUM_APP_SECRET=
BONUM_TERMINAL_ID=
BONUM_MERCHANT_CHECKSUM_KEY=
