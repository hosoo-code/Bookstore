# Copy to .env and fill in. Never commit .env.

# Required: PostgreSQL connection string (local Termux Postgres or Supabase session pooler)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: public site URL (used for sitemap / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: show tögrög (₮) instead of dollars
NEXT_PUBLIC_CURRENCY=MNT

# Optional: Supabase (Auth, Realtime, Storage). Leave empty for local accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
